<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: icons only -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView android:id="@+id/gridBtn" style="@style/TopIcon" android:text="▦" />
            <TextView android:id="@+id/wbBtn" style="@style/TopIcon" android:layout_width="wrap_content"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:text="WB" android:textSize="13sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/lensBtn" style="@style/TopIcon" android:text="◎" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView android:id="@+id/familyBtn" style="@style/TopIcon" android:layout_width="wrap_content"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:text="FUJI ▾" android:textSize="12sp"
                android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/logBtn" style="@style/TopIcon" android:layout_width="wrap_content"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:text="LOG" android:textSize="12sp"
                android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/nightBtn" style="@style/TopIcon" android:text="☾" android:visibility="gone" />
            <TextView android:id="@+id/moreBtn" style="@style/TopIcon" android:text="⋯" android:textSize="22sp" />
        </LinearLayout>

        <!-- Viewfinder (top-aligned) -->
        <FrameLayout
            android:id="@+id/viewfinder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.fujisim.cam.GridOverlay
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.fujisim.cam.FocusOverlay
                android:id="@+id/focusOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.fujisim.cam.HistogramView
                android:id="@+id/histogram"
                android:layout_width="112dp"
                android:layout_height="56dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <View
                android:id="@+id/flash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="#FFFFFF" />

            <TextView
                android:id="@+id/styleCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/pill"
                android:letterSpacing="0.08"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/recTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/rec_pill"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="● 00:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:id="@+id/styleNameBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/styleName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#99000000"
                        android:letterSpacing="0.1"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/styleDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/recipeInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:alpha="0"
                    android:background="@drawable/pill"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/originalBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/pill"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="ORIGINAL"
                    android:textColor="#FFC94A"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/zoomBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="3dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Look selector: recipe / preset carousel or the Styles pad -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="96dp">

            <HorizontalScrollView
                android:id="@+id/chipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="2dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/recipeBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/stylesBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:visibility="gone">

                <com.fujisim.cam.StylePad
                    android:id="@+id/stylePad"
                    android:layout_width="96dp"
                    android:layout_height="96dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PALETTE"
                        android:textColor="#AAAAAA"
                        android:letterSpacing="0.1"
                        android:textSize="10sp" />

                    <SeekBar
                        android:id="@+id/paletteBar"
                        android:layout_width="150dp"
                        android:layout_height="28dp"
                        android:max="100"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Mode bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView android:id="@+id/compareBtn" style="@style/TopIcon" android:text="A|B" android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/modeBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/modeVideo" style="@style/ModeItem" android:text="VIDEO" />
                <TextView android:id="@+id/modeFuji" style="@style/ModeItem" android:text="FUJI" />
                <TextView android:id="@+id/modeStyles" style="@style/ModeItem" android:text="STYLES" />
                <TextView android:id="@+id/modeNormal" style="@style/ModeItem" android:text="NORMAL" />
            </LinearLayout>

            <TextView android:id="@+id/editBtn" style="@style/TopIcon" android:text="✎" />
        </LinearLayout>

        <!-- Shutter row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/thumb_bg"
                android:contentDescription="Last capture"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <View
                android:id="@+id/shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/shutter"
                android:clickable="true"
                android:contentDescription="Shutter"
                android:focusable="true" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/flipBtn"
                style="@style/RoundBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:text="⟲"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom sheet for panels -->
    <LinearLayout
        android:id="@+id/editorContainer"
        android:layout_width="match_parent"
        android:layout_height="470dp"
        android:layout_gravity="bottom"
        android:background="@drawable/sheet_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/sheetHandle"
            android:layout_width="match_parent"
            android:layout_height="26dp">

            <View
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/handle" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/sheetContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/processingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/processingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Applying look to video… 0%"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/processingBar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100" />
    </LinearLayout>
</FrameLayout>
